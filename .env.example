# Copia este fichero a .env y rellena los valores.
# .env esta en .gitignore: nunca se sube al repositorio.

# --- Google OAuth (Fase 0) ---
# Google Cloud Console > APIs y servicios > Credenciales > Crear credenciales
# > ID de cliente de OAuth > Tipo de aplicacion: "Aplicacion de escritorio"
#
# Los clientes de escritorio NO tienen secreto real (van con PKCE), pero Google
# sigue emitiendo uno y el endpoint de token lo pide. No es material sensible,
# aun asi lo mantenemos fuera del repositorio.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx

# --- Gemini ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Modelo a usar. Comprueba en AI Studio cual es el Flash mas reciente disponible.
GEMINI_MODEL=gemini-2.5-flash
