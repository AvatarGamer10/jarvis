# Copia este fichero a .env y rellena los valores.
#
# OJO: copiar, no renombrar. Si renombras, te quedas sin la plantilla.
#
# .env esta en .gitignore: nunca se sube al repositorio.

# --- Google OAuth ---
# Google Cloud Console > APIs y servicios > Google Auth Platform > Clientes
# > Crear cliente > Tipo de aplicacion: "Aplicacion de escritorio"
#
# Los clientes de escritorio NO tienen un secreto de verdad: el flujo va con
# PKCE, donde la seguridad viene del code_verifier que se genera en cada inicio
# de sesion y nunca sale del equipo. Google emite un secreto igualmente y el
# endpoint de token lo pide. Aun asi se queda fuera del repositorio.

# Las usa el script del spike (scripts/spike-google.mjs).
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# Las mismas, con el prefijo que electron-vite inyecta en el proceso principal
# al compilar. Gracias a esto la app empaquetada ya trae credenciales y quien la
# use solo tiene que pulsar "Conectar con Google", sin crearse ningun proyecto
# en Google Cloud. Si las dejas vacias, la app las pedira en Ajustes.
MAIN_VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
MAIN_VITE_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# --- Gemini (opcional) ---
# Solo hace falta si eliges Gemini en lugar de Ollama como motor de IA.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
