{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "out/test",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    },
    "types": ["node"]
  },
  "include": [
    "src/main/organizer/paths.ts",
    "src/main/organizer/planner.ts",
    "src/main/organizer/executor.ts",
    "src/main/brief/next-occurrence.ts",
    "src/main/whatsNew.ts",
    "src/main/model-catalog.ts",
    "src/main/agent/tools/planner-core.ts",
    "src/main/tasks/grades-core.ts",
    "src/main/tasks/paste-core.ts",
    "src/renderer/src/lib/dates.ts",
    "src/renderer/src/lib/audio-speech.ts",
    "src/renderer/src/lib/week.ts",
    "src/renderer/src/lib/urgency.ts"
  ]
}
